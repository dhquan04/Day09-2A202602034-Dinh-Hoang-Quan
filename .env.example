# Copy this file to .env, then set your own key. Never commit .env.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini 2.5 Flash is the model used by the agent pipeline.
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter API configuration for API-backed agents (8B parameters).
OPENROUTER_API_KEY=your_rotated_openrouter_api_key_here
# Model name is fixed in src/openrouter.py as required by README.

# Local Ollama API used by the agent pipeline (no cloud API key required).
OLLAMA_BASE_URL=http://localhost:11434/api
OLLAMA_MODEL=gemma3:4b
